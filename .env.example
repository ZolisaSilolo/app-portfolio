# Environment Configuration
# Copy this file to .env and update with your values

# API Gateway URL from your AWS SAM deployment
VITE_API_BASE_URL=https://your-api-gateway-url.execute-api.region.amazonaws.com/prod

# Admin credentials (REQUIRED for production)
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=YourSecurePassword123!
REACT_APP_ADMIN_EMAIL=your-admin@example.com

# Optional: Analytics tracking ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
