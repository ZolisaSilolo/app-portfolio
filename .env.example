# Environment Configuration
# Copy this file to .env and update with your values

# API Gateway URL from your AWS SAM deployment
VITE_API_BASE_URL=https://your-api-gateway-url.execute-api.region.amazonaws.com/prod

# Admin page password — set a strong, unique value (required for production)
# This value is embedded in the client bundle; use it only for low-risk gating.
VITE_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: Analytics tracking ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Lambda: allowed CORS origin (set to your production domain, e.g. https://yourdomain.com)
CORS_ORIGIN=https://yourdomain.com

# Lambda: admin upload password (server-side, keep secret)
ADMIN_PASSWORD=change-me-server-side-secret

# Lambda: S3 bucket name for content uploads
CONTENT_BUCKET=your-portfolio-content

# Lambda: DynamoDB table names
SESSION_TABLE=portfolio-sessions
ANALYTICS_TABLE=portfolio-analytics
RATE_LIMIT_TABLE=portfolio-rate-limits

# Lambda: Cohere API secret name in AWS Secrets Manager
COHERE_SECRET_NAME=portfolio-cohere-api-key
