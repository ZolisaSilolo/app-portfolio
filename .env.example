# Environment Configuration
# Copy this file to .env and update with your values

# API Gateway URL from your AWS SAM deployment
# Get this from: sam deploy output or AWS Console > API Gateway
VITE_API_BASE_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/prod

# Optional: Analytics tracking ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Optional: Custom domain
# VITE_CUSTOM_DOMAIN=https://your-domain.com
